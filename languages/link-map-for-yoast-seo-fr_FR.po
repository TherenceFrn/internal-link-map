msgstr ""

#: link-map-for-yoast-seo.php:47
#: link-map-for-yoast-seo.php:201
msgid "Internal link map"
msgstr "Carte du maillage interne"

#: link-map-for-yoast-seo.php:48
msgid "Link map"
msgstr "Maillage"

#: link-map-for-yoast-seo.php:67
msgid "Yoast SEO has not indexed any internal link yet."
msgstr "Yoast SEO n’a encore indexé aucun lien interne."

#: link-map-for-yoast-seo.php:68
msgid "Internal link graph"
msgstr "Graphe du maillage interne"

#: link-map-for-yoast-seo.php:69
msgid "no incoming link"
msgstr "sans lien entrant"

#. translators: 1: number of incoming links, 2: number of outgoing links.
#: link-map-for-yoast-seo.php:71
#, php-format
msgid "%1$d incoming · %2$d outgoing"
msgstr "%1$d entrant(s) · %2$d sortant(s)"

#: link-map-for-yoast-seo.php:72
msgid "Find a page…"
msgstr "Rechercher une page…"

#: link-map-for-yoast-seo.php:73
msgid "Zoom in"
msgstr "Zoom avant"

#: link-map-for-yoast-seo.php:74
msgid "Zoom out"
msgstr "Zoom arrière"

#: link-map-for-yoast-seo.php:75
msgid "Fit to screen"
msgstr "Recentrer"

#. translators: %s: post type name, e.g. "Products".
#: link-map-for-yoast-seo.php:178
#, php-format
msgid "%s archive"
msgstr "Archive : %s"

#: link-map-for-yoast-seo.php:179
msgid "Home page"
msgstr "Page d’accueil"

#: link-map-for-yoast-seo.php:203
msgid "Internal links indexed by Yoast SEO. Node size: incoming links. Scroll to zoom, drag the background to move around, drag a node to rearrange. Click a node to isolate it with its neighbours, double-click to edit it. If the map is empty, run the SEO data optimization in Yoast SEO › Tools."
msgstr "Liens internes indexés par Yoast SEO. Taille d’un nœud : liens entrants. Molette pour zoomer, glissez le fond pour vous déplacer, glissez un nœud pour le repositionner. Cliquez sur un nœud pour l’isoler avec ses voisins, double-cliquez pour le modifier. Si la carte est vide, lancez l’optimisation des données SEO dans Yoast SEO › Outils."

#. translators: %d: number of orphan pages.
#: link-map-for-yoast-seo.php:210
#, php-format
msgid "Orphan content (%d)"
msgstr "Contenus orphelins (%d)"

#: link-map-for-yoast-seo.php:214
msgid "Every published page has at least one incoming link."
msgstr "Chaque contenu publié reçoit au moins un lien interne."

#: link-map-for-yoast-seo.php:219
msgid "Content"
msgstr "Contenu"

#: link-map-for-yoast-seo.php:220
msgid "Type"
msgstr "Type"

#: link-map-for-yoast-seo.php:221
