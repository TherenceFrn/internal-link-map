#: internal-link-map.php:47
#: internal-link-map.php:221
msgid "Internal link map"
msgstr "Carte du maillage interne"

#: internal-link-map.php:48
msgid "Link map"
msgstr "Maillage"

#: internal-link-map.php:67
msgid "Open map"
msgstr "Voir la carte"

#: internal-link-map.php:80
msgid "Yoast SEO has not indexed any internal link yet."
msgstr "Yoast SEO n’a encore indexé aucun lien interne."

#: internal-link-map.php:81
msgid "Internal link graph"
msgstr "Graphe du maillage interne"

#: internal-link-map.php:82
msgid "no incoming link"
msgstr "sans lien entrant"

#. translators: 1: number of incoming links, 2: number of outgoing links.
#: internal-link-map.php:84
#, php-format
msgid "%1$d incoming · %2$d outgoing"
msgstr "%1$d entrant(s) · %2$d sortant(s)"

#: internal-link-map.php:85
msgid "Find a page…"
msgstr "Rechercher une page…"

#: internal-link-map.php:86
msgid "Zoom in"
msgstr "Zoom avant"

#: internal-link-map.php:87
msgid "Zoom out"
msgstr "Zoom arrière"

#: internal-link-map.php:88
msgid "Fit to screen"
msgstr "Recentrer"

#: internal-link-map.php:89
msgid "Download as image"
msgstr "Télécharger en image"

#. translators: %s: post type name, e.g. "Products".
#: internal-link-map.php:195
#, php-format
msgid "%s archive"
msgstr "Archive : %s"

#: internal-link-map.php:196
msgid "Home page"
msgstr "Page d’accueil"

#: internal-link-map.php:197
msgid "Author archives"
msgstr "Archives d’auteur"

#: internal-link-map.php:198
msgid "Date archives"
msgstr "Archives par date"

#: internal-link-map.php:199
msgid "Search and error pages"
msgstr "Pages de recherche et d’erreur"

#: internal-link-map.php:223
msgid "Internal links found in your content by Yoast SEO (menus, header and footer are not counted). Node size: incoming links. Scroll to zoom, drag the background to move around, drag a node to rearrange. Click a node to isolate it with its neighbours, double-click to edit it. If the map is empty, run the SEO data optimization in Yoast SEO › Tools."
msgstr "Liens internes trouvés par Yoast SEO dans vos contenus (menus, en-tête et pied de page ne sont pas comptés). Taille d’un nœud : liens entrants. Molette pour zoomer, glissez le fond pour vous déplacer, glissez un nœud pour le repositionner. Cliquez sur un nœud pour l’isoler avec ses voisins, double-cliquez pour le modifier. Si la carte est vide, lancez l’optimisation des données SEO dans Yoast SEO › Outils."

#. translators: %d: number of orphan pages.
#: internal-link-map.php:233
#, php-format
msgid "Orphan content (%d)"
msgstr "Contenus orphelins (%d)"

#: internal-link-map.php:238
msgid "Every published page has at least one incoming link."
msgstr "Chaque contenu publié reçoit au moins un lien interne."

#: internal-link-map.php:240
msgid "Published content that no other page links to."
msgstr "Contenus publiés vers lesquels aucune autre page ne pointe."

#. translators: %d: number of outgoing internal links.
#: internal-link-map.php:253
#, php-format
msgid "%d outgoing link"
msgid_plural "%d outgoing links"
msgstr[0] "%d lien sortant"
msgstr[1] "%d liens sortants"
