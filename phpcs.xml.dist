<?xml version="1.0"?>
<ruleset name="Internal Link Map">
    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_wp_version" value="6.5"/>

    <rule ref="PHPCompatibilityWP"/>
    <rule ref="WordPress-Extra">
        <!-- One plugin file named after the slug, namespaced functions. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="internal-link-map"/>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array" value="InternalLinkMap,lmys"/>
        </properties>
    </rule>
</ruleset>
